<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- shared with the complication (#186) -->
	<key>HeartAppGroup</key>
	<string>group.$(HOST_BUNDLE_IDENTIFIER)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Heart reads your heart rate and active energy on Apple Watch during a workout, to show them on your wrist. They stay on your devices — Heart never uploads them.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Heart saves each workout you track with Apple Watch to the Health app, with the heart rate and energy your watch measured, so your rings credit your training. Nothing leaves your devices.</string>
	<key>WKApplication</key>
	<true/>
	<!-- keeps the app running, wrist down, while its workout session does (#184) -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<!-- Not a literal: `flutter build ios` finds a watch companion by reading this
	     key from Watch/Info.plist and resolving it against Runner's build settings,
	     which is why HOST_BUNDLE_IDENTIFIER is defined on both targets. Without the
	     match Flutter passes `-sdk iphoneos` and the watch target cannot build. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(HOST_BUNDLE_IDENTIFIER)</string>
</dict>
</plist>
