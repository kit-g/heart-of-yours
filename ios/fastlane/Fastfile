default_platform(:ios)

require 'json'

def appstore_api_key
  key_info = JSON.parse(File.read(File.join(__dir__, "appstore_key.json")))

  app_store_connect_api_key(
    key_id: key_info["keyId"],
    issuer_id: key_info["issuerId"],
    key_filepath: "fastlane/AuthKey_#{key_info["keyId"]}.p8",
    duration: 1200,
    in_house: false
  )
end

# The bundles embedded in the app, as target name => the suffix of its bundle id
# under the app's: the workout Live Activity's widget extension (#133) and the
# watch app (#187). Each is signed with its own App Store profile, and each needs
# that profile in the match store before its first deploy.
EMBEDDED = {
  "OngoingWorkout" => "OngoingWorkout",
  "Watch" => "watchkitapp",
}

def app_identifiers(app_id)
  [app_id] + EMBEDDED.values.map { |suffix| "#{app_id}.#{suffix}" }
end

platform :ios do
  # Create or regenerate the App Store provisioning profiles for one environment — the
  # app and every bundle in EMBEDDED. `beta` reads the match store readonly, so this
  # lane is the only thing that writes to it, and it has to run before the first deploy
  # of any *new* bundle id: an id with no profile in the store fails the deploy outright,
  # which is how v1.9.0 lost both iOS builds to the extension added in #133.
  #
  # The store is per environment, under `secrets/fastlane/` in that environment's own
  # secrets bucket, so the bucket and the `env:` have to agree. They hold *different*
  # distribution certificates — dev `266GN79443`, prod `QC7UNCH57V` — and both are
  # installed on the release machine, which is how a dev profile ends up carrying prod's
  # certificate: the build then fails at archive with "doesn't include signing
  # certificate", long after match has happily installed everything. If that happens,
  # regenerate that environment's profiles with `force:true` and check the certificate
  # the new profile carries against `certs/distribution/` in the matching bucket.
  #
  #   MATCH_S3_BUCKET=<bucket> MATCH_PASSWORD=<passphrase> fastlane profiles env:dev
  #   MATCH_S3_BUCKET=<bucket> MATCH_PASSWORD=<passphrase> fastlane profiles env:prod force:true
  #
  # Without `force` only missing profiles are created. That is what a new bundle id
  # wants: regenerating the profile that already signs a shipped build invalidates it to
  # produce an identical one. Pass `force:true` after a capability changes on the App ID,
  # which is the one case where the cached profile is stale rather than absent.
  #
  # Passing the API key is what stops match falling back to interactive Apple ID prompts.
  desc "Create missing App Store provisioning profiles, or force-regenerate them"
  lane :profiles do |options|
    app_id = options[:env] == 'prod' ? "me.heart-of.ios" : "me.heart-of.ios.dev"

    match(
      type: "appstore",
      app_identifier: app_identifiers(app_id),
      api_key: appstore_api_key,
      readonly: false,
      force: options[:force].to_s == 'true'
    )
  end

  desc "Push a new build to TestFlight"
  # single lane and pass the environment (dev/prod) as an argument
  lane :beta do |options|
    env = options[:env] # 'dev' or 'prod'

    app_id = env == 'prod' ? "me.heart-of.ios" : "me.heart-of.ios.dev"
    scheme = env == 'prod' ? "prod" : "dev"
    configuration = env == 'prod' ? "Release-prod" : "Release-dev"

    setup_ci

    api_key = appstore_api_key

    match(
      type: "appstore",
      app_identifier: app_identifiers(app_id),
      readonly: true
    )

    latest_build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: app_id
    )

    increment_build_number(
        build_number: latest_build_number + 1,
        xcodeproj: "Runner.xcodeproj"
    )

    # Update the Xcode project directly for the Runner target only
    # This bypasses the global SPM signing bug
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "DFX2JYT8BM",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{app_id}",
      targets: ["Runner"],
      build_configurations: [configuration]
    )

    # each embedded bundle is signed with its own profile, or the archive's export fails
    EMBEDDED.each do |target, suffix|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        team_id: "DFX2JYT8BM",
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{app_id}.#{suffix}",
        targets: [target],
        build_configurations: [configuration]
      )
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store"
    )

    # "What to Test", written by the `release-notes` skill. A missing file is not fatal —
    # the build still ships, just without notes.
    notes_path = File.join(__dir__, "..", "..", "release_notes", "testflight.txt")
    changelog = File.exist?(notes_path) ? File.read(notes_path) : nil
    UI.important("No release_notes/testflight.txt — uploading without What to Test") if changelog.nil?

    # skip_waiting_for_build_processing is false so the lane waits out Apple's processing,
    # which is what lets the changelog be set at all. Waiting is free on a public repo.
    # The timeout is generous: on expiry pilot raises, which would fail an otherwise fine
    # deploy — the build is already uploaded by then, only the notes are lost.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 3600,
      submit_beta_review: false,
      changelog: changelog
    )
  end
end