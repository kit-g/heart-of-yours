#!/bin/bash
# Host-side agent for UI work: full macOS toolchain, simulators, screenshots.
#
#   agents/host-agent <name> [--task "..." | --issue N] [--base BRANCH]
#
# Weaker isolation than the containers — it runs as you. Safety comes from
# four layers: worktree isolation (edits outside the worktree are blocked),
# acceptEdits mode plus the allowlist in .claude/settings.local.json (anything
# unlisted still prompts), the guard hook (no commit/push/destructive git,
# even if a rule would allow it), and a deny list for the GoLand MCP tools
# that execute, write, or touch databases — those would run through your IDE,
# outside both the allowlist and the guard hook (which matches Bash only).
# GoLand's read-only tools (search, read, problems, git status) stay available.
#
# Give it its own simulator so it never fights you for yours:
#   xcrun simctl create agent-iphone "iPhone 17"
#
#   --base BRANCH  branch the worktree from BRANCH instead of main — another
#                  agent's branch (worktree-a2) to stack this work on it
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"

NAME="${1:?usage: agents/host-agent <name> [--task \"...\" | --issue N] [--base BRANCH]}"
shift

TASK="" ISSUE="" BASE="" BASE_SET=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --task)  TASK="$2"; shift 2 ;;
    --issue) ISSUE="$2"; shift 2 ;;
    --base)  BASE="$2"; BASE_SET=1; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

# shellcheck source=worktree.sh
. "$HERE/worktree.sh"
ensure_worktree "$REPO" "$NAME" "$BASE" "$BASE_SET"

if [[ -n "$ISSUE" ]]; then
  TASK="$(gh -R "$(git -C "$REPO" remote get-url origin)" issue view "$ISSUE" \
    --json number,title,body \
    --template 'GitHub issue #{{.number}}: {{.title}}

{{.body}}')"
fi

PROMPT_PREFIX="You are an autonomous agent in an isolated worktree of this repo.
docs/handoff.md is your definition of done — work through its checklist,
then run the review-handoff skill on your own work (self-review mode: fix what
it finds, re-run, leave REVIEW.md describing the final tree), and only then
write HANDOFF.md at the worktree root. This worktree is fresh: run 'make
codegen codegen-app' before 'make lint' or the analyzer reports missing
mocks. A red lint or test, or a check you could not run, is a blocker to
report — never rationalize it into an open end. Your worktree branches
from '$WORKTREE_BASE' and your pull request will target it; your work is what
'git diff HEAD' shows. Name that base in HANDOFF.md. UI changes must be
screenshot-verified on the 'agent-iphone' simulator (and an iPad if the
surface has a two-pane layout) — never the user's own simulators. If this
task came from a GitHub issue, post your closing summary as a comment on it
('gh issue comment') — that one outward action is pre-authorized; nothing
else outward is. Never commit or push. End with a short summary: what
changed, verification, open ends."

# GoLand MCP tools that execute or write. Denied for agents regardless of
# the allowlist: deny beats allow. Read-only GoLand tools are fine.
DISALLOWED="mcp__goland__execute_terminal_command mcp__goland__execute_run_configuration \
mcp__goland__execute_tool mcp__goland__run_inspection_kts mcp__goland__apply_patch \
mcp__goland__create_new_file mcp__goland__rename_refactoring mcp__goland__reformat_file \
mcp__goland__open_file_in_editor mcp__goland__execute_sql_query \
mcp__goland__create_database_connection mcp__goland__edit_database_connection"

cd "$REPO"
if [[ -n "$TASK" ]]; then
  # Plain -p is silent until the run ends. Stream the session instead and
  # render it with the same filter `watch` uses; the raw event stream
  # survives in $LOG for post-mortems.
  LOG="${TMPDIR:-/tmp}/heart-agent-$NAME.jsonl"
  echo "narrating; raw stream: $LOG" >&2
  claude --worktree "$NAME" --permission-mode acceptEdits \
    --disallowedTools $DISALLOWED \
    --output-format stream-json --verbose -p "$PROMPT_PREFIX

$TASK" | tee "$LOG" | jq -rj -f "$HERE/narrate.jq"
else
  exec claude --worktree "$NAME" --permission-mode acceptEdits \
    --disallowedTools $DISALLOWED
fi
