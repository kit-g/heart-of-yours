#!/bin/bash
# Live view into a running containerized agent's session.
#
#   agents/watch <name>        follow the narration from the start
#
# Read-only: Ctrl-C stops the view, never the agent. Ends when the
# container exits (the final summary is in `docker logs heart-agent-<name>`).
set -euo pipefail

NAME="${1:?usage: agents/watch <name>}"

exec docker exec "heart-agent-$NAME" sh -c \
  'tail -f -n +1 "$CLAUDE_CONFIG_DIR"/projects/*/*.jsonl' | jq -rj '
  select(.type == "assistant") | .message.content[]? |
    if .type == "text" then .text + "\n"
    elif .type == "tool_use" then
      "  → " + .name + "  " +
      ((.input.description // .input.command // .input.file_path // .input.prompt // "")
        | tostring | gsub("\\n"; " ") | .[0:140]) + "\n"
    else empty end'
