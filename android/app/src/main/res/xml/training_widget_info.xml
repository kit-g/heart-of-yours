<?xml version="1.0" encoding="utf-8"?>
<!-- The training widget (#161). Its settings are optional on adding it (the
     last 7 days' volume until the user picks otherwise) and reachable again
     from a long press. The midnight redraw is TrainingWidget's own alarm, so
     there is no periodic update. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="me.heart.TrainingWidgetSettings"
    android:description="@string/widget_training_description"
    android:initialLayout="@layout/widget_training_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_training_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
