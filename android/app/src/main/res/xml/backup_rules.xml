<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API <= 30. heart.db is a server-synced cache, so
     excluding it stops a stale / old-schema copy being restored on reinstall. -->
<full-backup-content>
    <exclude domain="database" path="heart.db" />
    <exclude domain="database" path="heart.db-wal" />
    <exclude domain="database" path="heart.db-shm" />
</full-backup-content>
