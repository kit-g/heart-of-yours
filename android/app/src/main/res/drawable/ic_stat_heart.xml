<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon. Same curves as the launcher icon and the splash mark
     (`ic_splash_heart.xml`) — one shape, one source.

     Android treats a small icon as a *mask*: it keeps the alpha channel, throws
     the colours away, and tints what is left. Pointing it at the launcher icon,
     which is full-bleed and has almost no transparency, left only the outer
     silhouette — a hollow ring in the shade. So this is deliberately flat white
     on nothing: the fill colour below is never the colour that is drawn, it is
     only what defines the opaque area.

     24dp canvas, and the heart is fitted to the 20dp live area Material asks
     for (2dp of clearance on every side): the path spans x 2..62 and y 6.7..57
     in its own 64-unit space, so a 1/3 scale plus 1.333 of translation centres
     it with the right margins. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.3333"
        android:scaleY="0.3333"
        android:translateX="1.333"
        android:translateY="1.333">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M32.00,13.42 C10.07,-8.51 -22.82,28.04 32.00,57.27 C86.82,28.04 53.93,-8.51 32.00,13.42 Z" />
    </group>
</vector>
