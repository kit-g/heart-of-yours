<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Heart runs no ads, and the advertising ID is a cross-app tracking
         identifier — squarely against what the listing promises about a
         user's data. None of these four are ours: `firebase_analytics`
         merges them in through play-services-measurement, and Play then
         asks us to declare that the app uses an advertising ID.

         Removing the permission is only half of it — see
         `google_analytics_adid_collection_enabled` on the application
         below, which is the switch that actually stops the collection.
         Verify with the merged manifest, never this file:
           build/app/intermediates/merged_manifest/prodRelease/…/AndroidManifest.xml -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Both scheduled notifications — the rest timer and the idle-workout
         reminder — go through `AlarmManager.setExactAndAllowWhileIdle`
         (`androidScheduleMode: .exactAllowWhileIdle`, notifications.dart:236
         and :259). Since Android 12 that call needs an exact-alarm permission,
         and without one it fails: the user was asked for POST_NOTIFICATIONS,
         granted it, and then nothing ever arrived — verified on API 35.

         `USE_EXACT_ALARM` rather than `SCHEDULE_EXACT_ALARM` because a rest
         timer is the case it exists for. It is granted at install and cannot be
         revoked, so a timer the user set always fires; `SCHEDULE_EXACT_ALARM`
         is user-revocable and would need a second permission journey for the
         same feature. Play reviews this declaration — it belongs in the
         questionnaire beside the health ones. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- So a rest timer that was running when the phone rebooted still fires.
         Paired with ScheduledNotificationBootReceiver below, which is the only
         thing that reads it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect, and exactly the six metrics `Health.tracked` names.
         Every entry here is a permission the user is asked to grant, so the
         list is a product decision rather than a convenience: no background
         reads (nothing reads in the background), nothing speculative. -->
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- The only thing Heart writes: the session the user just finished, as an
         ExerciseSessionRecord. Note there is no matching READ_EXERCISE — Heart
         does not read workouts back, from itself or from anything else, and
         asking for a read it would never use is exactly the kind of overreach
         the list above avoids. Deliberately not accompanied by a calorie write
         either: without a watch session there is no measurement of energy, and
         an estimate that disagrees with the watch's own is worse than none.
         Writing this requires the Play Console health data declaration to
         cover writing, not just reading. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- Without this, Health Connect serves only the 30 days before the moment
         permission was granted, whatever window is asked for. The backfill would
         run its whole chunked walk back to 2014 and come home with a month —
         silently, because an empty window and a withheld one look identical.
         Granted separately from the six above; see `DeviceHealthStore`. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <meta-data
                android:name="com.google.firebase.messaging.default_notification_channel_id"
                android:value="default_channel_id" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect refuses to show the permission sheet at all
                 unless the app can be asked why it wants the data. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Only the paths go_router owns. The host also serves Firebase auth
                 actions under /__/auth/*, which must stay in the browser; Android
                 intent-filters have no exclusion syntax, so the app claims paths
                 explicitly. A new top-level route needs a <data> entry here. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/workout"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/activeWorkout"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/history"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/exercises"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/profile"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/gallery"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/avatar"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/login"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/restoreAccount"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/apple"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/done"
                    android:scheme="https" />
                <data
                    android:host="${deepLink}"
                    android:pathPrefix="/upgradeApp"
                    android:scheme="https" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="heart" />
            </intent-filter>
        </activity>
        <!-- Android 14 and up route "why does this app have my health data?"
             here, from the system privacy screens and Health Connect's consent
             sheet. It used to be an alias onto MainActivity, which met the
             manifest requirement and answered nothing: the app opened on
             Profile. The activity now hands the policy to the browser and
             finishes — see its class comment.

             `permission` is what keeps this to the system: only a caller
             holding START_VIEW_PERMISSION_USAGE may start it, which is also why
             it cannot be exercised from `adb`. Translucent and out of recents
             because it draws nothing and lives for one `onCreate`. -->
        <activity
            android:name=".ViewPermissionUsageActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- flutter_local_notifications stopped declaring these in its own
             manifest (its AndroidManifest.xml carries permissions only), so the
             app has to. Without them `zonedSchedule` succeeds, AlarmManager
             holds the alarm, the alarm fires on time — and the broadcast
             reaches no receiver, so nothing is ever posted. It fails in total
             silence: no exception, no log line, an entry in `dumpsys alarm`
             that looks perfectly healthy. Both scheduled notifications were
             dead this way on Android: the rest timer and the idle-workout
             reminder. Verified on API 35 by watching an alarm fire with an
             empty notification list, then again with these present.

             The boot receiver re-arms pending alarms after a reboot or an app
             update, which Android otherwise drops on the floor. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- The permission removal above keeps the advertising ID out of the
             manifest; this keeps Analytics from asking for it at runtime. Both
             are needed — the permission alone is what Play reads, the flag is
             what the SDK obeys. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Package visibility. Without these the app cannot resolve an
             implicit intent into Health Connect and `startActivity` throws
             ActivityNotFoundException — even though `adb shell cmd package
             query-activities` finds the handler, because the shell sees every
             package and the app sees a filtered view.
             The package entry covers the standalone app of Android 13 and
             earlier; the actions cover the platform component it became, which
             lives in Settings and is not a package we can name. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
