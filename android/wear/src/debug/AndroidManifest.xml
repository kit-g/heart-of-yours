<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a phone state planted on a watch with no phone, for
     screenshots and UI tests on an emulator -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="me.heart.wear.debug.STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
