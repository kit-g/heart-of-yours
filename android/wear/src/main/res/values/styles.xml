<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wear OS 3 has no system splash; core-splashscreen draws the same one
         from the launcher icon on every version -->
    <style name="Theme.Heart.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
